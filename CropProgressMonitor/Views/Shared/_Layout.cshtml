<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CropProgress Monitor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark agri-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning text-dark" style="width:34px;height:34px;">
                        <i class="bi bi-sprout fs-5"></i>
                    </span>
                    <span>CropProgress Monitor</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index" data-show-loader="true">
                                    <i class="bi bi-grid-1x2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Fields" ? "active" : "")" asp-controller="Fields" asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i>Add Field
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Growth" ? "active" : "")" asp-controller="Growth" asp-action="Timeline" data-show-loader="true">
                                    <i class="bi bi-signpost-split me-1"></i>Timeline
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Weather" ? "active" : "")" asp-controller="Weather" asp-action="Index" data-show-loader="true">
                                    <i class="bi bi-cloud-sun me-1"></i>Weather
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Advisory" ? "active" : "")" asp-controller="Advisory" asp-action="Index">
                                    <i class="bi bi-journal-medical me-1"></i>Advisory
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "History" ? "active" : "")" asp-controller="History" asp-action="Index">
                                    <i class="bi bi-clock-history me-1"></i>History
                                </a>
                            </li>
                            @if (User.IsInRole(DbInitializer.AdminRole))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(controller == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-sliders me-1"></i>Admin
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="py-4">
        <div class="container">
            @if (TempData["StatusMessage"] is string statusMsg)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@statusMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] is string errMsg)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@errMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="agri-footer py-3 mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                <strong>CropProgress Monitor</strong> &bull; INT402 Project &bull; Real-Time Agricultural Growth Stage Estimation
            </div>
            <div class="small">
                Weather powered by <a href="https://open-meteo.com/" target="_blank" rel="noopener" class="text-decoration-none text-success fw-semibold">Open-Meteo</a> &bull;
                <span class="text-muted">Estimates are thermal-time approximations, not exact field measurements.</span>
            </div>
        </div>
    </footer>

    <!-- Global Loading Overlay -->
    <div id="globalLoadingOverlay" class="loading-overlay" role="status" aria-live="polite">
        <div class="agri-card p-4 text-center shadow-lg" style="min-width: 260px;">
            <div class="spinner-border text-success mb-3" style="width: 2.75rem; height: 2.75rem;" aria-hidden="true"></div>
            <div id="globalLoadingMessage" class="fw-semibold text-dark">Fetching live weather &amp; computing GDD...</div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
