@model ErrorViewModel
@{
    ViewData["Title"] = "Something Went Wrong";
}

<div class="row justify-content-center my-5">
    <div class="col-md-7">
        <div class="agri-card p-5 text-center fade-in-up">
            <div class="display-4 text-warning mb-3">
                <i class="bi bi-exclamation-octagon"></i>
            </div>
            <h2 class="fw-bold mb-2">We ran into an unexpected issue</h2>
            <p class="text-muted mb-4">
                Please try again or return to your dashboard. If an external weather service is temporarily slow, cached field data remains safe.
            </p>
            @if (Model.ShowRequestId)
            {
                <p class="small text-muted mb-4">
                    Reference ID: <code>@Model.RequestId</code>
                </p>
            }
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-forest px-4">
                    <i class="bi bi-house me-1"></i>Home
                </a>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-success px-4">
                    <i class="bi bi-grid-1x2 me-1"></i>Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
