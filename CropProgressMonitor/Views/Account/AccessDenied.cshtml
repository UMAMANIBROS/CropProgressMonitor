@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6">
        <div class="agri-card p-5 text-center fade-in-up">
            <div class="display-4 text-danger mb-3"><i class="bi bi-shield-lock"></i></div>
            <h2 class="fw-bold">Access Denied</h2>
            <p class="text-muted mb-4">You do not have permission to view this resource.</p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-forest px-4">Return to Dashboard</a>
        </div>
    </div>
</div>
