@model GrowthTimelineViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Growth Stage Timeline";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 fade-in-up">
    <div>
        <span class="badge-stage mb-2 d-inline-block"><i class="bi bi-signpost-split me-1"></i>Phenological Timeline</span>
        <h2 class="fw-bold mb-1">@Model.FieldName &mdash; @Model.CropName @(string.IsNullOrEmpty(Model.Variety) ? "" : $"({Model.Variety})")</h2>
        <p class="text-muted mb-0">
            <i class="bi bi-geo-alt me-1"></i>@Model.LocationName &bull;
            Sown: <strong>@Model.SowingDate.ToString("dd MMM yyyy")</strong> &bull;
            Tbase: <strong>@Model.BaseTemperature°C</strong>
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Timeline" asp-route-id="@Model.FieldCropId" asp-route-refresh="true" class="btn btn-outline-success" data-show-loader="true" data-loader-text="Syncing Open-Meteo weather & recalculating GDD...">
            <i class="bi bi-arrow-clockwise me-1"></i>Recalculate
        </a>
        <a asp-controller="Advisory" asp-action="Index" asp-route-fieldCropId="@Model.FieldCropId" class="btn btn-forest">
            <i class="bi bi-journal-medical me-1"></i>View Advisory
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.WeatherWarning))
{
    <div class="alert alert-warning rounded-3 mb-4">
        <i class="bi bi-wifi-off me-2"></i>@Model.WeatherWarning
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="agri-card p-3 h-100 fade-in-up">
            <div class="small text-muted">Current Stage (Est.)</div>
            <div class="fs-4 fw-bold text-success mt-1">@Model.CurrentStageName</div>
            <div class="small text-muted">@Model.ProgressPercent.ToString("F0")% season progress</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="agri-card p-3 h-100 fade-in-up">
            <div class="small text-muted">Accumulated GDD</div>
            <div class="fs-4 fw-bold text-dark mt-1">@Model.AccumulatedGdd.ToString("F1") <span class="fs-6 fw-normal">°C·d</span></div>
            <div class="small text-muted">Today: +@Model.TodayGdd.ToString("F1") °C·d</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="agri-card p-3 h-100 fade-in-up">
            <div class="small text-muted">Next Growth Stage</div>
            <div class="fs-4 fw-bold text-dark mt-1">@(Model.NextStageName ?? "Harvest Ready")</div>
            <div class="small text-muted">7-day avg: @Model.AverageRecentDailyGdd.ToString("F1") GDD/day</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="agri-card p-3 h-100 fade-in-up">
            <div class="small text-muted">Est. Next Stage Date</div>
            <div class="fs-4 fw-bold text-warning-emphasis mt-1">
                @(Model.EstimatedNextStageDate.HasValue ? Model.EstimatedNextStageDate.Value.ToString("dd MMM yyyy") : "—")
            </div>
            <div class="small text-muted">Projected via 7-day forecast</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="agri-card p-4 h-100 fade-in-up">
            <h5 class="fw-bold mb-4"><i class="bi bi-list-check text-success me-2"></i>Growth Stage Sequence</h5>
            <div class="stage-timeline">
                @foreach (var stage in Model.Stages)
                {
                    <div class="timeline-item @stage.Status">
                        <div class="timeline-dot">
                            @if (stage.Status == "completed")
                            {
                                <i class="bi bi-check-lg"></i>
                            }
                            else if (stage.Status == "current")
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else
                            {
                                <span class="small fw-bold">@stage.StageOrder</span>
                            }
                        </div>
                        <div class="agri-card timeline-card p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold">@stage.StageName</span>
                                    @if (stage.Status == "current")
                                    {
                                        <span class="badge bg-warning text-dark ms-2">Current Stage</span>
                                    }
                                    else if (stage.Status == "completed")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success ms-2">Completed</span>
                                    }
                                </div>
                                <span class="small fw-semibold text-muted">@stage.GddThreshold GDD</span>
                            </div>
                            @if (stage.Status == "upcoming")
                            {
                                <div class="small text-muted mt-1">
                                    Needs <strong>@stage.RemainingGdd.ToString("F1")</strong> more GDD to reach threshold.
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="agri-card p-4 h-100 fade-in-up d-flex flex-column">
            <h5 class="fw-bold mb-3"><i class="bi bi-graph-up-arrow text-success me-2"></i>Cumulative GDD Since Sowing</h5>
            <div style="min-height: 290px;" class="flex-grow-1">
                <canvas id="gddCurveChart"></canvas>
            </div>
            <div class="alert alert-light border mt-3 mb-0 small text-muted">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Estimate Notice:</strong> Calculated using daily GDD = max(0, (Tmax + Tmin)/2 − @Model.BaseTemperature°C). Results are weather-based approximations, not exact field measurements.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const series = @Html.Raw(JsonSerializer.Serialize(Model.DailyGddSeries.Select(d => new {
                date = d.Date.ToString("MMM dd"),
                gdd = d.CumulativeGdd
            })));

            const ctx = document.getElementById('gddCurveChart');
            if (!ctx) return;

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: series.map(s => s.date),
                    datasets: [{
                        label: 'Accumulated GDD (°C·d)',
                        data: series.map(s => s.gdd),
                        borderColor: '#2E7D32',
                        backgroundColor: 'rgba(46, 125, 50, 0.14)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true }
                    },
                    scales: {
                        y: { beginAtZero: true, title: { display: true, text: 'GDD (°C·d)' } }
                    }
                }
            });
        })();
    </script>
}
